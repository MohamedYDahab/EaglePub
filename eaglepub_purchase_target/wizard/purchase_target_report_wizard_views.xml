<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════ Result Lines ═══════════ -->

    <record id="purchase_target_report_line_view_list" model="ir.ui.view">
        <field name="name">purchase.target.report.line.list</field>
        <field name="model">purchase.target.report.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Target Report" create="false" delete="false"
                  default_order="partner_id, product_id"
                  decoration-success="percentage &gt;= 100"
                  decoration-warning="percentage &gt;= 50 and percentage &lt; 100"
                  decoration-danger="percentage &lt; 50">
                <field name="currency_id" column_invisible="True"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="target_qty" sum="Target Qty"/>
                <field name="achieved_qty" sum="Received Qty"/>
                <field name="variance_qty" sum="Variance Qty"/>
                <field name="target_amount" string="Target Value" sum="Target Amount"/>
                <field name="achieved_amount" string="Received Value" sum="Received Amount"/>
                <field name="variance_amount" sum="Variance Amount"/>
                <field name="percentage" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="purchase_target_report_line_view_pivot" model="ir.ui.view">
        <field name="name">purchase.target.report.line.pivot</field>
        <field name="model">purchase.target.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Target Report">
                <field name="partner_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="target_qty" type="measure"/>
                <field name="achieved_qty" type="measure"/>
                <field name="target_amount" string="Target Value" type="measure"/>
                <field name="achieved_amount" string="Received Value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="purchase_target_report_line_view_graph" model="ir.ui.view">
        <field name="name">purchase.target.report.line.graph</field>
        <field name="model">purchase.target.report.line</field>
        <field name="arch" type="xml">
            <graph string="Purchase Target Report" type="bar">
                <field name="partner_id"/>
                <field name="target_amount" string="Target Value" type="measure"/>
                <field name="achieved_amount" string="Received Value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="purchase_target_report_line_view_search" model="ir.ui.view">
        <field name="name">purchase.target.report.line.search</field>
        <field name="model">purchase.target.report.line</field>
        <field name="arch" type="xml">
            <search string="Search Results">
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter name="below_target" string="Below Target"
                        domain="[('percentage', '&lt;', 100)]"/>
                <filter name="on_target" string="On Target"
                        domain="[('percentage', '&gt;=', 100)]"/>
                <group>
                    <filter name="group_partner" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_target_report_line_action" model="ir.actions.act_window">
        <field name="name">Purchase Target Report</field>
        <field name="res_model">purchase.target.report.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="purchase_target_report_line_view_search"/>
        <field name="context">{}</field>
    </record>

    <!-- ═══════════ Wizard ═══════════ -->

    <record id="purchase_target_report_wizard_view_form" model="ir.ui.view">
        <field name="name">purchase.target.report.wizard.form</field>
        <field name="model">purchase.target.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Target Report">
                <group>
                    <group string="Period">
                        <field name="period_type" widget="radio"/>
                        <field name="year"
                               invisible="period_type == 'custom'"/>
                        <field name="quarter"
                               invisible="period_type != 'quarterly'"
                               required="period_type == 'quarterly'"/>
                        <field name="date_from"
                               readonly="period_type != 'custom'"/>
                        <field name="date_to"
                               readonly="period_type != 'custom'"/>
                    </group>
                    <group string="Filters">
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="All vendors"/>
                        <field name="product_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="All products"/>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>
                </group>
                <div class="text-muted mt-2">
                    <i class="fa fa-info-circle me-1"/>
                    Only targets whose period falls entirely inside the selected
                    range are included.
                </div>
                <footer>
                    <button name="action_view" type="object"
                            string="View" class="btn-primary"
                            icon="fa-table"/>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF" class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" type="object"
                            string="Export XLSX" class="btn-secondary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="purchase_target_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Purchase Target Report</field>
        <field name="res_model">purchase.target.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="purchase_target_report_menu"
              name="Target Report"
              parent="purchase.menu_purchase_root"
              action="purchase_target_report_wizard_action"
              sequence="16"/>

</odoo>
