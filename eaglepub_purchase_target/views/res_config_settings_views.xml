<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase_target"
            model="ir.ui.view">
        <field name="name">res.config.settings.form.purchase.target</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']"
                   position="inside">
                <setting id="purchase_target_alert_setting"
                         string="Replenishment Alert Tolerance"
                         help="Shortfall below which a purchase target line is not reported, as a share of its monthly forecast. Zero alerts on any shortfall.">
                    <div class="content-group">
                        <div class="mt16">
                            <field name="purchase_target_alert_tolerance"
                                   class="o_light_label"/> %
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
