<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="purchase_target_view_list" model="ir.ui.view">
        <field name="name">purchase.target.list</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'expired'"
                  decoration-success="state != 'expired' and progress &gt;= 100"
                  decoration-warning="state != 'expired' and progress &gt;= 75 and progress &lt; 100"
                  decoration-danger="state != 'expired' and progress &lt; 50">
                <field name="state" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="total_target_qty"/>
                <field name="total_achieved_qty"/>
                <field name="total_amount_untaxed" optional="show"/>
                <field name="total_achieved" optional="hide"/>
                <field name="period_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="progress" widget="progressbar"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="purchase_target_view_form" model="ir.ui.view">
        <field name="name">purchase.target.form</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <form string="Purchase Target">
                <header>
                    <field name="state" invisible="True"/>
                    <button name="action_refresh"
                            type="object"
                            string="Refresh"
                            class="oe_highlight"
                            icon="fa-refresh"/>
                    <button name="action_next_period"
                            type="object"
                            string="Next Period"
                            icon="fa-forward"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-line-chart"
                                type="object" name="action_refresh">
                            <div class="o_stat_info">
                                <field name="progress" widget="progressbar"/>
                            </div>
                        </button>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'expired'">
                        This target period has ended. Use <b>Next Period</b> to
                        create a new target.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="True"/></h1>
                    </div>

                    <group>
                        <group string="Vendor">
                            <field name="partner_id"
                                   readonly="state == 'expired'"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"
                                   readonly="state == 'expired'"/>
                            <field name="user_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state == 'expired'"/>
                        </group>
                        <group string="Period">
                            <field name="period_type"
                                   readonly="state == 'expired'"/>
                            <field name="date_start"
                                   readonly="state == 'expired'"/>
                            <field name="date_end"
                                   readonly="state == 'expired'"/>
                            <field name="auto_renew"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Target Lines" name="lines">
                            <field name="line_ids"
                                   readonly="state == 'expired'">
                                <list editable="bottom">
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="target_qty"/>
                                    <field name="uom_id" string="Unit"/>
                                    <field name="price_unit"/>
                                    <field name="amount_untaxed"
                                           sum="Target Value"/>
                                    <field name="current_stock_qty"
                                           string="Current Stock"/>
                                    <field name="qty_ordered_not_received"
                                           string="Ordered Not Delivered"/>
                                    <field name="monthly_forecast" optional="hide"/>
                                    <field name="lead_time_days" optional="hide"/>
                                    <field name="safety_stock" optional="hide"/>
                                    <field name="available_qty" optional="hide"/>
                                    <field name="replenishment_qty" optional="show"
                                           decoration-danger="needs_replenishment"
                                           decoration-bf="needs_replenishment"/>
                                    <field name="needs_replenishment"
                                           column_invisible="True"/>
                                    <field name="achieved_qty"/>
                                    <field name="achieved_amount" optional="show"
                                           sum="Received Value"/>
                                    <field name="achieved_percentage"
                                           string="Received %"/>
                                    <field name="remaining_qty"/>
                                    <button name="action_view_purchase_orders"
                                            type="object"
                                            icon="fa-file-text-o"
                                            title="Open the purchase orders behind this figure"/>
                                    <button name="action_view_receipts"
                                            type="object"
                                            icon="fa-truck"
                                            title="Open the receipts that delivered this quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Summary" name="summary">
                            <group>
                                <group string="Quantity">
                                    <field name="total_target_qty"/>
                                    <field name="total_achieved_qty"/>
                                    <field name="remaining_qty_total"/>
                                    <field name="progress" widget="progressbar"/>
                                </group>
                                <group string="Value (excl. tax)">
                                    <field name="total_amount_untaxed"/>
                                    <field name="total_achieved"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Graph View -->
    <record id="purchase_target_view_graph" model="ir.ui.view">
        <field name="name">purchase.target.graph</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <graph string="Purchase Targets" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="total_target_qty" type="measure"/>
                <field name="total_achieved_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="purchase_target_view_pivot" model="ir.ui.view">
        <field name="name">purchase.target.pivot</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Targets" sample="1">
                <field name="partner_id" type="row"/>
                <field name="period_type" type="col"/>
                <field name="total_target_qty" type="measure"/>
                <field name="total_achieved_qty" type="measure"/>
                <field name="total_amount_untaxed" type="measure"/>
                <field name="total_achieved" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="purchase_target_view_search" model="ir.ui.view">
        <field name="name">purchase.target.search</field>
        <field name="model">purchase.target</field>
        <field name="arch" type="xml">
            <search string="Search Purchase Targets">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="needs_replenishment" string="Replenishment Needed"
                        domain="[('line_ids.needs_replenishment', '=', True)]"/>
                <separator/>
                <filter name="period_monthly" string="Monthly"
                        domain="[('period_type', '=', 'monthly')]"/>
                <filter name="period_quarterly" string="Quarterly"
                        domain="[('period_type', '=', 'quarterly')]"/>
                <filter name="period_yearly" string="Yearly"
                        domain="[('period_type', '=', 'yearly')]"/>
                <filter name="period_custom" string="Custom"
                        domain="[('period_type', '=', 'custom')]"/>
                <group>
                    <filter name="group_partner" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_period" string="Period Type"
                            context="{'group_by': 'period_type'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="purchase_target_action" model="ir.actions.act_window">
        <field name="name">Purchase Targets</field>
        <field name="res_model">purchase.target</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="purchase_target_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first purchase target
            </p>
            <p>
                Set targets per vendor on specific products. Achievement is
                measured on goods actually received, in the period they arrived.
            </p>
        </field>
    </record>

    <!-- Menu: Purchase > Purchase Targets -->
    <menuitem id="purchase_target_menu"
              name="Purchase Targets"
              parent="purchase.menu_purchase_root"
              action="purchase_target_action"
              sequence="15"/>

</odoo>
