<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_eaglepub_pos" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.eaglepub.pos</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Point of Sale" name="eaglepub_pos">
                    <field name="eaglepub_pos_policy_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
