<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="sale_order_form_lots">
        <field name="name">sale.order.form.lots</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                <field name="lot_ids" string="Lots / Serials" widget="many2many_tags" optional="show"/>
                <button name="action_view_lots" type="object" icon="fa-list"
                        title="View Lots / Serials"/>
            </xpath>
        </field>
    </record>

</odoo>
