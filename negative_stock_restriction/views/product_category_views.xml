<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_neg_stock" model="ir.ui.view">
        <field name="name">product.category.form.neg.stock</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="allow_negative_stock" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
