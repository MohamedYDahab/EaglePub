<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_form_view_neg_stock" model="ir.ui.view">
        <field name="name">stock.warehouse.form.neg.stock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Negative Stock">
                    <field name="allow_negative_stock" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
