<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="neg_stock_warning_wizard_form" model="ir.ui.view">
        <field name="name">neg.stock.warning.wizard.form</field>
        <field name="model">neg.stock.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Low Stock Warning">
                <div class="alert alert-warning mb-3" role="alert">
                    <strong>⚠️ Confirming this order will take stock negative.</strong>
                </div>
                <field name="order_ids" invisible="1"/>
                <field name="message" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm Anyway" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
