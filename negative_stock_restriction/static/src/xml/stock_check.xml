<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="negative_stock_restriction.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!-- Stock Check button in the overflow menu -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton"
               position="after">
            <button t-att-class="buttonClass"
                    t-on-click="() => this.onClickStockCheck()">
                <i class="fa fa-boxes me-1" role="img"
                   aria-label="Check Stock" title="Check Stock"/>
                فحص المخزون / Check Stock
            </button>
        </xpath>

        <!-- Visible Stock Check button before the More button -->
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button class="btn btn-danger btn-lg flex-shrink-0"
                    t-if="!props.showRemainingButtons"
                    t-on-click="() => this.onClickStockCheck()">
                <i class="fa fa-exclamation-triangle me-1" role="img"
                   aria-label="Check Stock" title="Check Stock"/>
                فحص المخزون
            </button>
        </xpath>

    </t>

</templates>
