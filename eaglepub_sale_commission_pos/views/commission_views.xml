<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commission_view_form_pos" model="ir.ui.view">
        <field name="name">eaglepub.commission.form.inherit.pos</field>
        <field name="model">eaglepub.commission</field>
        <field name="inherit_id" ref="eaglepub_sale_commission.commission_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='reference']" position="after">
                <field name="pos_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
