<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Product Packaging Form View -->
    <record id="product_packaging_form_view_pos" model="ir.ui.view">
        <field name="name">product.packaging.form.pos</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="available_in_pos"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Packaging List View -->
    <record id="product_packaging_list_view_pos" model="ir.ui.view">
        <field name="name">product.packaging.list.pos</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="available_in_pos"/>
            </xpath>
        </field>
    </record>


</odoo>
