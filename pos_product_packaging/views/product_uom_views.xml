<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product UoM (Packaging) List View -->
    <record id="product_uom_list_view_pos" model="ir.ui.view">
        <field name="name">product.uom.list.pos</field>
        <field name="model">product.uom</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="barcode"/>
                <field name="available_in_pos"/>
            </list>
        </field>
    </record>

    <!-- Action to manage POS packaging -->
    <record id="action_product_uom_pos" model="ir.actions.act_window">
        <field name="name">POS Packagings</field>
        <field name="res_model">product.uom</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_uom_list_view_pos"/>
        <field name="domain">[('available_in_pos', '=', True)]</field>
        <field name="context">{'search_default_available_in_pos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No packagings enabled for POS yet.
            </p>
            <p>
                Go to a product's Sales tab, add packaging UoMs,
                then check "Available in POS" here.
            </p>
        </field>
    </record>

    <!-- Menu item under POS Configuration -->
    <menuitem
        id="menu_product_uom_pos"
        name="POS Packagings"
        parent="point_of_sale.pos_config_menu_catalog"
        action="action_product_uom_pos"
        sequence="30"/>

</odoo>
