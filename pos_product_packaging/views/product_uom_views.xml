<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_uom_list_view_pos" model="ir.ui.view">
        <field name="name">uom.uom.list.pos</field>
        <field name="model">uom.uom</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="relative_factor"/>
                <field name="relative_uom_id"/>
                <field name="available_in_pos"/>
            </list>
        </field>
    </record>
    <record id="action_product_uom_pos" model="ir.actions.act_window">
        <field name="name">POS Packagings</field>
        <field name="res_model">uom.uom</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_uom_list_view_pos"/>
        <field name="domain">[("available_in_pos", "=", True)]</field>
        <field name="context">{"search_default_available_in_pos": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No packagings enabled for POS yet.
            </p>
            <p>
                Go to a product Sales tab, add packaging UoMs,
                then check Available in POS here.
            </p>
        </field>
    </record>
    <menuitem
        id="menu_product_uom_pos"
        name="POS Packagings"
        parent="point_of_sale.pos_config_menu_catalog"
        action="action_product_uom_pos"
        sequence="30"/>
</odoo>
