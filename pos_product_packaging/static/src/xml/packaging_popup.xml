<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_product_packaging.PackagingPopup">
        <Dialog title="props.title or 'Select Packaging'">
            <div class="packaging-popup-body">
                <!-- Packaging Selection -->
                <div class="packaging-selection mb-3">
                    <h5 class="mb-2">Select Packaging:</h5>
                    <div class="packaging-list d-flex flex-wrap gap-2">
                        <t t-foreach="packagings" t-as="packaging" t-key="packaging.id">
                            <button
                                class="btn packaging-item"
                                t-attf-class="btn {{ state.selectedPackaging?.id === packaging.id ? 'btn-primary' : 'btn-outline-secondary' }}"
                                t-on-click="() => this.selectPackaging(packaging)">
                                <div class="packaging-name fw-bold">
                                    <t t-esc="packaging.name"/>
                                </div>
                                <div class="packaging-qty text-muted">
                                    <t t-esc="packaging.qty"/> units
                                </div>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Package Quantity Input -->
                <div class="package-qty-input mb-3" t-if="state.selectedPackaging">
                    <h5 class="mb-2">Package Quantity:</h5>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-secondary btn-lg" t-on-click="decrementQty">
                            <i class="fa fa-minus"/>
                        </button>
                        <input
                            type="number"
                            class="form-control text-center"
                            style="width: 100px; font-size: 1.5rem;"
                            t-att-value="state.packageQty"
                            t-on-change="onPackageQtyChange"
                            min="1"/>
                        <button class="btn btn-secondary btn-lg" t-on-click="incrementQty">
                            <i class="fa fa-plus"/>
                        </button>
                    </div>
                </div>

                <!-- Summary -->
                <div class="packaging-summary p-3 bg-light rounded" t-if="state.selectedPackaging">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-muted">Packages:</div>
                            <div class="fs-4 fw-bold text-primary">
                                <t t-esc="state.packageQty"/> x <t t-esc="state.selectedPackaging?.name"/>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted">Total Units:</div>
                            <div class="fs-4 fw-bold text-success">
                                <t t-esc="state.totalQty"/> units
                            </div>
                        </div>
                    </div>
                    <div class="packaging-price-block">
                        <div class="d-flex justify-content-between">
                            <span class="price-label">Unit Price:</span>
                            <span class="price-value">
                                <t t-esc="formatCurrency(unitPrice)"/>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="price-label">
                                Price / <t t-esc="state.selectedPackaging?.name"/>:
                            </span>
                            <span class="price-value">
                                <t t-esc="formatCurrency(state.packagePrice)"/>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="price-label">Subtotal (excl. tax):</span>
                            <span class="price-value">
                                <t t-esc="formatCurrency(state.totalPriceExcl)"/>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between" t-if="state.totalTax">
                            <span class="price-label">Taxes:</span>
                            <span class="price-value text-warning">
                                + <t t-esc="formatCurrency(state.totalTax)"/>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mt-1 pt-1 border-top">
                            <span class="price-label">Total (<t t-esc="state.packageQty"/> pkg, incl. tax):</span>
                            <span class="price-value package-total-price">
                                <t t-esc="formatCurrency(state.totalPriceIncl)"/>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- No Packaging Message -->
                <div class="alert alert-info" t-if="!state.selectedPackaging">
                    Please select a packaging type above.
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-outline-danger" t-on-click="clearPackaging">
                    <i class="fa fa-times me-1"/>Add Single Unit
                </button>
                <button class="btn btn-secondary" t-on-click="cancel">
                    Cancel
                </button>
                <button
                    class="btn btn-primary"
                    t-on-click="confirm"
                    t-att-disabled="!state.selectedPackaging">
                    <i class="fa fa-check me-1"/>
                    Confirm
                </button>
            </t>
        </Dialog>
    </t>

</templates>
