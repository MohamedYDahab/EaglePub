<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend orderline to show packaging info -->
    <t t-name="pos_product_packaging.OrderlinePackaging" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <div t-if="props.line.packaging_id" class="packaging-info text-muted small">
                <i class="fa fa-cube me-1"/>
                <span>
                    <t t-esc="props.line.package_qty"/> x
                    <t t-esc="props.line.packaging_id.name"/>
                </span>
            </div>
        </xpath>
    </t>

</templates>
