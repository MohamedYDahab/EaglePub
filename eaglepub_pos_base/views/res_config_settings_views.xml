<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_eaglepub_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.eaglepub.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="EaglePub" id="eaglepub_pos_section">
                    <setting string="Manager PIN"
                             help="Typed at the till to authorise a restricted action. Checked on the server, never sent to the browser.">
                        <field name="pos_eaglepub_manager_pin" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
