<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ten columns need the extra width -->
    <record id="paperformat_sale_target" model="report.paperformat">
        <field name="name">Sales Target Report (A4 Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sale_target" model="ir.actions.report">
        <field name="name">Sales Target Report</field>
        <field name="model">sale.target.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eaglepub_sale_target.report_sales</field>
        <field name="report_file">eaglepub_sale_target.report_sales</field>
        <field name="print_report_name">'Sales Target Report'</field>
        <field name="paperformat_id" ref="paperformat_sale_target"/>
    </record>

</odoo>
