<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Account Move Form View - Add lot/expiry to invoice lines -->
    <record id="view_move_form_lot_expiry" model="ir.ui.view">
        <field name="name">account.move.form.lot.expiry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add lot and expiry columns after quantity in invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='quantity']" position="after">
                <field name="is_direct_invoice" column_invisible="1"/>
                <field name="manual_lot_ids"
                       string="Lots (Manual)"
                       widget="many2many_tags"
                       invisible="1"
                       column_invisible="not parent.id"
                       domain="[('product_id', '=', product_id)]"
                       options="{'no_create': True}"/>
                <field name="lot_names_display"
                       string="Lot/Serial"
                       optional="hide"
                       readonly="1"/>
                <field name="expiry_dates_display"
                       string="Expiry Date"
                       optional="hide"
                       readonly="1"/>
                <field name="ref"
                       string="Lot Reference"
                       optional="hide"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>