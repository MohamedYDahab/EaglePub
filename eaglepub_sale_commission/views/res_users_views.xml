<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_view_form_commission" model="ir.ui.view">
        <field name="name">res.users.form.inherit.eaglepub.commission</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Commission" name="eaglepub_commission">
                    <group>
                        <field name="eaglepub_commission_plan_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
