<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="commission_plan_view_list" model="ir.ui.view">
        <field name="name">eaglepub.commission.plan.list</field>
        <field name="model">eaglepub.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="basis"/>
                <field name="base_on"/>
                <field name="user_count" string="Salespeople"/>
            </list>
        </field>
    </record>

    <record id="commission_plan_view_form" model="ir.ui.view">
        <field name="name">eaglepub.commission.plan.form</field>
        <field name="model">eaglepub.commission.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard 5%"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="basis"/>
                            <field name="base_on"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rules" name="rules">
                            <div class="alert alert-info" role="status">
                                The <b>first matching rule wins</b>, top to bottom. Put your
                                exceptions above the general case.
                            </div>
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="applies_to"/>
                                    <field name="product_id"
                                           invisible="applies_to != 'product'"
                                           required="applies_to == 'product'"/>
                                    <field name="categ_id"
                                           invisible="applies_to != 'category'"
                                           required="applies_to == 'category'"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Salespeople" name="people">
                            <div class="alert alert-info" role="status">
                                Assign a salesperson from
                                <b>Settings &#8594; Users &amp; Companies &#8594; Users</b>,
                                on the <b>Commission</b> tab.
                            </div>
                            <field name="user_ids" readonly="1" nolabel="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="sequence" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="commission_plan_action" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">eaglepub.commission.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up your first commission plan</p>
            <p>
                A plan says when commission is earned, what it is calculated on,
                and at what rate. Assign it to as many salespeople as you like.
            </p>
        </field>
    </record>

</odoo>
