<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_bill_ocr" model="ir.ui.view">
        <field name="name">account.move.form.inherit.eaglepub.bill.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Check the lines" bg_color="text-bg-warning"
                        invisible="eaglepub_ocr_state != 'check'"/>
                <widget name="web_ribbon" title="Sample data" bg_color="text-bg-danger"
                        invisible="eaglepub_ocr_state != 'sample'"/>
                <div class="alert alert-danger" role="alert"
                     invisible="eaglepub_ocr_state != 'sample'">
                    <b>Your document was not read.</b>
                    <field name="eaglepub_ocr_message" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="eaglepub_ocr_state != 'check' or not eaglepub_ocr_message">
                    <field name="eaglepub_ocr_message" readonly="1" nolabel="1"/>
                </div>
                <field name="eaglepub_ocr_state" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_eaglepub_digitise" type="object"
                        string="Digitise Document" class="btn-secondary"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"
                        help="Read the attached supplier document into this bill."/>
            </xpath>
        </field>
    </record>

</odoo>
