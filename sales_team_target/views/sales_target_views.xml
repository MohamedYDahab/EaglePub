<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════ SEARCH VIEW ═══════════ -->
    <record id="view_sales_target_search" model="ir.ui.view">
        <field name="name">sales.target.search</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="pos_config_id"/>
                <filter name="my_targets" string="My Targets"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="type_salesperson" string="Salesperson Targets"
                        domain="[('target_type', '=', 'salesperson')]"/>
                <filter name="type_pos" string="POS Targets"
                        domain="[('target_type', '=', 'pos')]"/>
                <separator/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="on_target" string="On Target"
                        domain="[('achievement_ratio', '&gt;=', 100)]"/>
                <filter name="below_target" string="Below Target"
                        domain="[('achievement_ratio', '&lt;', 100)]"/>
                <group>
                    <filter name="group_type" string="Target Type"
                            context="{'group_by': 'target_type'}"/>
                    <filter name="group_user" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_pos" string="Point of Sale"
                            context="{'group_by': 'pos_config_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'month'}"/>
                    <filter name="group_year" string="Year"
                            context="{'group_by': 'year'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- ═══════════ LIST VIEW ═══════════ -->
    <record id="view_sales_target_list" model="ir.ui.view">
        <field name="name">sales.target.list</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <list string="Sales Targets"
                  decoration-success="achievement_ratio &gt;= 100"
                  decoration-warning="achievement_ratio &gt;= 50 and achievement_ratio &lt; 100"
                  decoration-danger="achievement_ratio &lt; 50">
                <field name="target_type" widget="badge"
                       decoration-info="target_type == 'salesperson'"
                       decoration-success="target_type == 'pos'"/>
                <field name="user_id"
                       column_invisible="context.get('default_target_type') == 'pos'"
                       optional="show"/>
                <field name="pos_config_id"
                       column_invisible="context.get('default_target_type') == 'salesperson'"
                       optional="show"/>
                <field name="month"/>
                <field name="year"/>
                <field name="target_amount" sum="Total Target"/>
                <field name="invoice_amount" sum="Total Invoices"
                       optional="show"/>
                <field name="pos_amount" sum="Total POS"
                       optional="show"/>
                <field name="achieved_amount" sum="Total Achieved"/>
                <field name="achievement_ratio" widget="progressbar"
                       options="{'max_value': 100}"/>
                <field name="remaining_amount" sum="Total Remaining"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'closed'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════ FORM VIEW ═══════════ -->
    <record id="view_sales_target_form" model="ir.ui.view">
        <field name="name">sales.target.form</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <form string="Sales Target">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_close" string="Close"
                            type="object" class="btn-secondary"
                            invisible="state != 'confirmed'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state == 'draft'"
                            groups="sales_team.group_sale_manager"/>
                    <button name="action_refresh"
                            string="Refresh Sales Data"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-line-chart"
                                name="action_refresh" type="object">
                            <div class="o_stat_info">
                                <field name="achievement_ratio"
                                       widget="statinfo"
                                       string="Achievement %"/>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group string="Target Definition">
                            <field name="target_type"
                                   readonly="state != 'draft'"
                                   widget="radio"/>
                            <field name="user_id"
                                   readonly="state != 'draft'"
                                   invisible="target_type != 'salesperson'"
                                   required="target_type == 'salesperson'"
                                   options="{'no_create': True}"/>
                            <field name="pos_config_id"
                                   readonly="state != 'draft'"
                                   invisible="target_type != 'pos'"
                                   required="target_type == 'pos'"
                                   options="{'no_create': True}"/>
                            <field name="month"
                                   readonly="state != 'draft'"/>
                            <field name="year"
                                   readonly="state != 'draft'"/>
                            <field name="target_amount"
                                   readonly="state == 'closed'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Achievement Summary">
                            <field name="invoice_amount"
                                   invisible="target_type != 'salesperson'"/>
                            <field name="pos_amount"
                                   invisible="target_type != 'pos'"/>
                            <field name="achieved_amount"
                                   decoration-success="achieved_amount &gt;= target_amount"
                                   decoration-danger="achieved_amount &lt; target_amount"/>
                            <field name="remaining_amount"
                                   decoration-danger="remaining_amount &gt; 0"
                                   decoration-success="remaining_amount &lt;= 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sales Details" name="details">
                            <field name="line_ids" readonly="1">
                                <list string="Detail Lines" create="false"
                                      edit="false" delete="false"
                                      decoration-danger="source_type == 'credit_note'">
                                    <field name="date"/>
                                    <field name="source_type" widget="badge"
                                           decoration-info="source_type == 'invoice'"
                                           decoration-success="source_type == 'pos'"
                                           decoration-danger="source_type == 'credit_note'"/>
                                    <field name="reference"/>
                                    <field name="partner_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id"
                                           column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════ KANBAN VIEW ═══════════ -->
    <record id="view_sales_target_kanban" model="ir.ui.view">
        <field name="name">sales.target.kanban</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="month">
                <field name="target_type"/>
                <field name="user_id"/>
                <field name="pos_config_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="target_amount"/>
                <field name="achieved_amount"/>
                <field name="achievement_ratio"/>
                <field name="invoice_amount"/>
                <field name="pos_amount"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click
                            #{record.achievement_ratio.raw_value >= 100
                                ? 'border-start border-success border-3'
                                : record.achievement_ratio.raw_value >= 50
                                    ? 'border-start border-warning border-3'
                                    : 'border-start border-danger border-3'}">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-if="record.target_type.raw_value == 'salesperson'">
                                                <i class="fa fa-user me-1"/>
                                                <field name="user_id"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-shopping-cart me-1"/>
                                                <field name="pos_config_id"/>
                                            </t>
                                        </strong>
                                    </div>
                                    <span t-attf-class="badge rounded-pill
                                        #{record.state.raw_value == 'draft' ? 'text-bg-info' :
                                          record.state.raw_value == 'confirmed' ? 'text-bg-success' :
                                          'text-bg-secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>

                                <div class="row mb-1">
                                    <div class="col-6">
                                        <span class="text-muted">Target:</span>
                                        <strong>
                                            <field name="target_amount"
                                                   widget="monetary"/>
                                        </strong>
                                    </div>
                                    <div class="col-6 text-end">
                                        <span class="text-muted">Achieved:</span>
                                        <strong>
                                            <field name="achieved_amount"
                                                   widget="monetary"/>
                                        </strong>
                                    </div>
                                </div>

                                <div class="row mb-1">
                                    <div class="col-12">
                                        <small class="text-muted">
                                            <t t-if="record.target_type.raw_value == 'salesperson'">
                                                Invoices:
                                                <field name="invoice_amount"
                                                       widget="monetary"/>
                                            </t>
                                            <t t-else="">
                                                POS Orders:
                                                <field name="pos_amount"
                                                       widget="monetary"/>
                                            </t>
                                        </small>
                                    </div>
                                </div>

                                <div class="mt-2">
                                    <field name="achievement_ratio"
                                           widget="progressbar"
                                           options="{'max_value': 100,
                                               'editable': false}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════ GRAPH VIEW ═══════════ -->
    <record id="view_sales_target_graph" model="ir.ui.view">
        <field name="name">sales.target.graph</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <graph string="Sales Target Comparison" type="bar">
                <field name="display_name"/>
                <field name="target_amount" type="measure"/>
                <field name="achieved_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ═══════════ PIVOT VIEW ═══════════ -->
    <record id="view_sales_target_pivot" model="ir.ui.view">
        <field name="name">sales.target.pivot</field>
        <field name="model">sales.target</field>
        <field name="arch" type="xml">
            <pivot string="Sales Targets Analysis">
                <field name="target_type" type="col"/>
                <field name="display_name" type="row"/>
                <field name="target_amount" type="measure"/>
                <field name="achieved_amount" type="measure"/>
                <field name="invoice_amount" type="measure"/>
                <field name="pos_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ═══════════ ACTIONS ═══════════ -->

    <!-- All Targets (Manager) -->
    <record id="action_sales_target_all" model="ir.actions.act_window">
        <field name="name">Sales Targets</field>
        <field name="res_model">sales.target</field>
        <field name="view_mode">list,kanban,form,graph,pivot</field>
        <field name="search_view_id" ref="view_sales_target_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first sales target
            </p>
            <p>
                Define monthly targets for salespersons (invoices) or
                Points of Sale (POS orders) and track achievements.
            </p>
        </field>
    </record>

    <!-- My Targets (Salesperson) -->
    <record id="action_sales_target_my" model="ir.actions.act_window">
        <field name="name">My Targets</field>
        <field name="res_model">sales.target</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sales_target_search"/>
        <field name="context">{'search_default_my_targets': 1}</field>
    </record>

    <!-- Dashboard -->
    <record id="action_sales_target_dashboard" model="ir.actions.act_window">
        <field name="name">Target Dashboard</field>
        <field name="res_model">sales.target</field>
        <field name="view_mode">graph,pivot,list,kanban</field>
        <field name="search_view_id" ref="view_sales_target_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</odoo>
