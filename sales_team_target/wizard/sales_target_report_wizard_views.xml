<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_target_report_wizard_form" model="ir.ui.view">
        <field name="name">sales.target.report.wizard.form</field>
        <field name="model">sales.target.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sales Target Report">
                <group>
                    <group string="Target Type">
                        <field name="target_type" widget="radio"/>
                    </group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <group>
                    <group string="Filters">
                        <field name="company_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="user_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="All Salespersons"
                               invisible="target_type == 'pos'"/>
                        <field name="pos_config_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="All Points of Sale"
                               invisible="target_type == 'salesperson'"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export Excel"
                            type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sales_target_report_wizard"
            model="ir.actions.act_window">
        <field name="name">Sales Target Report</field>
        <field name="res_model">sales.target.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sales_target_report_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
